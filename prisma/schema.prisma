generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Production {
  id            String   @id @default(cuid())
  title         String
  artistName    String
  artistCity    String
  artistCountry String   @default("Colombia")
  year          Int
  genre         String
  coverUrl      String?
  spotifyUrl    String?
  youtubeUrl    String?
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([genre])
  @@index([year])
}

model Release {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  artistName    String
  genre         String
  releaseYear   Int
  coverUrl      String?
  spotifyUrl    String?
  youtubeUrl    String?
  appleUrl      String?
  deezerUrl     String?
  amazonUrl     String?
  tidalUrl      String?
  soundcloudUrl String?
  /// Fecha de lanzamiento (si es futura, el front muestra cuenta regresiva)
  releaseDate   DateTime?
  description   String?
  featured      Boolean   @default(false)
  /// Si es true, aparece en /releases (página de próximos lanzamientos y adelantos). Los ya publicados van con false.
  upcoming      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([genre])
  @@index([releaseYear])
  @@index([upcoming])
}

model Beat {
  id                String   @id @default(cuid())
  title             String
  genre             String
  bpm               Int?
  mood              String?
  /// Precio "desde" (licencia más barata)
  priceCOP          Int
  priceMp3COP       Int?
  priceWavCOP       Int?
  priceStemsCOP     Int?
  priceExclusiveCOP Int?
  status            String   @default("AVAILABLE")
  /// Preview de audio (MP3)
  audioUrl          String?
  coverUrl          String?
  exclusive         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([genre])
  @@index([status])
}

model BookingSession {
  id               String    @id @default(cuid())
  serviceType      String
  artistName       String
  artistEmail      String
  artistPhone      String
  artistInstagram  String?
  musicReference   String
  vision           String?
  genres           String
  isFirstTime      Boolean   @default(true)
  scheduledDate    DateTime
  timeSlot         String
  status           String    @default("PENDING")
  internalNotes    String?
  confirmedAt      DateTime?
  completedAt      DateTime?
  policyAcceptedAt DateTime?
  policyVersion    String?
  marketingOptIn   Boolean   @default(false)
  /// null = no respondió; false = menor de edad (requiere acudiente)
  isAdult          Boolean?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([scheduledDate])
  @@index([artistEmail])
}

model BlockedDate {
  id        String   @id @default(cuid())
  /// Calendario yyyy-MM-dd (UTC) para evitar desfaces por zona horaria.
  dateKey   String
  /// "DAY" = día completo; o "morning" | "afternoon" | "night" para una franja.
  scope     String   @default("DAY")
  reason    String?
  createdAt DateTime @default(now())

  @@unique([dateKey, scope])
  @@index([dateKey])
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

/// Configuración única del sitio (textos, imágenes, enlaces). Borrador vs publicado.
model SiteConfig {
  id             String    @id @default("default")
  publishedJson  Json
  draftJson      Json
  publishedAt    DateTime?
  draftUpdatedAt DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Metadatos internos de la app (flags de migración de datos, etc.). Clave/valor.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Vista de página pública (para métricas en el panel admin). Sin datos personales.
model PageView {
  id        String   @id @default(cuid())
  path      String   @default("/")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Producto/merch de la tienda
model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  priceCOP     Int
  /// Precio anterior (tachado), opcional
  compareAtCOP Int?
  category     String   @default("Merch")
  /// URLs absolutas o /uploads/... (la primera es la portada)
  images       String[] @default([])
  /// Tallas/variantes, p. ej. ["S","M","L"]
  sizes        String[] @default([])
  /// null = sin control de inventario
  stock        Int?
  /// ACTIVE | DRAFT | SOLD_OUT
  status       String   @default("ACTIVE")
  featured     Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([featured])
  @@index([sortOrder])
}

/// Archivo subido desde el admin (fallback cuando no hay Vercel Blob)
model MediaAsset {
  id        String   @id
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

/// Canal de YouTube (sello, crew, artistas, aliados). Sustituye a `youtube.channels` del SiteConfig.
model YoutubeChannel {
  id               String   @id @default(cuid())
  name             String
  url              String
  /// UC…
  channelId        String?
  /// @handle
  handle           String?
  description      String?
  avatarUrl        String?
  featuredVideoUrl String?
  /// Crew | Artista | Sello | Aliado…
  category         String   @default("Crew")
  featured         Boolean  @default(false)
  /// ACTIVE | HIDDEN
  status           String   @default("ACTIVE")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, featured, sortOrder])
}

/// Interés en un beat (lead CRM)
model BeatInterest {
  id               String   @id @default(cuid())
  beatId           String?
  beatTitle        String
  artistName       String
  email            String
  phone            String?
  instagram        String?
  message          String?
  exclusiveIntent  Boolean  @default(false)
  /// MP3 | WAV | STEMS | EXCLUSIVE
  licenseType      String?
  policyAcceptedAt DateTime
  policyVersion    String
  marketingOptIn   Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

/// Mensaje del formulario de contacto / prensa
model ContactMessage {
  id               String   @id @default(cuid())
  /// PRENSA | DEMO | BOOKING_ARTISTA | COLABORACION | OTRO
  subject          String
  name             String
  email            String
  phone            String?
  message          String
  policyAcceptedAt DateTime
  policyVersion    String
  /// NEW | READ | ARCHIVED
  status           String   @default("NEW")
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
}

/// Suscriptor del newsletter
model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  source           String    @default("footer")
  policyAcceptedAt DateTime
  policyVersion    String
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())
}

/// Fuente del feed social "Novedades" (canal de YouTube, página de Facebook o búsqueda en YouTube)
model SocialSource {
  id            String    @id @default(cuid())
  /// YOUTUBE_CHANNEL | FACEBOOK_PAGE | YOUTUBE_SEARCH
  kind          String
  label         String
  /// UC… | id o username de la página | texto de búsqueda
  externalId    String
  url           String?
  enabled       Boolean   @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([kind, externalId])
}

/// Publicación del feed social (video de YouTube, post de Facebook o enlace manual)
model SocialPost {
  id          String   @id @default(cuid())
  sourceId    String?
  /// YOUTUBE_VIDEO | FACEBOOK_POST | LINK
  kind        String
  /// yt:<videoId> | fb:<postId> | link:<sha1(url)>
  externalId  String   @unique
  title       String
  text        String?
  url         String
  imageUrl    String?
  author      String?
  publishedAt DateTime
  /// VISIBLE | HIDDEN
  status      String   @default("VISIBLE")
  pinned      Boolean  @default(false)
  raw         Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, pinned, publishedAt])
}
