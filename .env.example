DATABASE_URL="postgresql://postgres:password@host:6543/postgres?pgbouncer=true&schema=sodimusic"
DIRECT_URL="postgresql://postgres:password@host:5432/postgres?schema=sodimusic"
PORT=4000
FRONTEND_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
# Día de calendario del estudio (Vercel corre en UTC; sin esto las sesiones pueden “moverse” un día).
CALENDAR_TZ="America/Bogota"
# En Vercel: usa la URL pública del frontend (Next), no localhost, para CORS y enlaces en correos
# FRONTEND_URL="https://tu-frontend.vercel.app"
# SITE_URL="https://tu-frontend.vercel.app"
JWT_SECRET="mismo-valor-que-NEXTAUTH_SECRET-del-frontend"
RESEND_API_KEY=""
ADMIN_EMAIL="Jeivymusicdinero@gmail.com"
NEXT_PUBLIC_WHATSAPP="573215368590"
# Usuario admin en BD: tras `prisma db seed` la contraseña por defecto es sodimusic2016 (cambiala en prod).
# Vitest/Playwright usan ADMIN_EMAIL / ADMIN_PASSWORD o el seed si el email coincide.
# Almacenamiento de archivos subidos desde el admin (POST /api/admin/upload).
# Opcional: token Read/Write del store Vercel Blob "sodimusic-media" (Vercel → Storage → Blob → .env.local).
# Si falta, los archivos se guardan en la tabla MediaAsset (Postgres) y se sirven por GET /uploads/:name.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
