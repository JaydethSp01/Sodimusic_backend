DATABASE_URL="postgresql://postgres:password@host:6543/postgres?pgbouncer=true&schema=sodimusic"
DIRECT_URL="postgresql://postgres:password@host:5432/postgres?schema=sodimusic"
PORT=4000
FRONTEND_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
# Día de calendario del estudio (Vercel corre en UTC; sin esto las sesiones pueden “moverse” un día).
CALENDAR_TZ="America/Bogota"
# En Vercel: usa la URL pública del frontend (Next), no localhost, para CORS y enlaces en correos
# FRONTEND_URL="https://tu-frontend.vercel.app"
# SITE_URL="https://tu-frontend.vercel.app"
JWT_SECRET="mismo-valor-que-NEXTAUTH_SECRET-del-frontend"
# Resend: correos transaccionales (sesiones, contacto, bienvenida al newsletter con enlace de baja). Vacío = solo log.
RESEND_API_KEY=""
# URL pública de esta API para enlaces en correos (baja del newsletter). Si falta, se deduce de la petición.
# API_URL="https://sodimusic-backend.vercel.app"
# Rate limit en memoria de los formularios públicos (subscribe, contacto, interés en beats, reservas):
# 10 peticiones por IP (x-forwarded-for) cada 10 min → 429. Pon 1 para desactivarlo (tests de integración).
# RATE_LIMIT_DISABLED=1
ADMIN_EMAIL="Jeivymusicdinero@gmail.com"
NEXT_PUBLIC_WHATSAPP="573215368590"
# Usuario admin en BD: tras `prisma db seed` la contraseña por defecto es sodimusic2016 (cambiala en prod).
# Vitest/Playwright usan ADMIN_EMAIL / ADMIN_PASSWORD o el seed si el email coincide.
# Almacenamiento de archivos subidos desde el admin (POST /api/admin/upload).
# Opcional: token Read/Write del store Vercel Blob "sodimusic-media" (Vercel → Storage → Blob → .env.local).
# Si falta, los archivos se guardan en la tabla MediaAsset (Postgres) y se sirven por GET /uploads/:name.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
# ---- Novedades (feed social) ----
# Opcional: clave de YouTube Data API v3 (gratuita). Con ella se usan playlistItems (fechas exactas)
# y search (menciones "Sodimusic" en canales ajenos). Sin clave se lee el HTML público del canal.
# YOUTUBE_API_KEY=""
# Opcional: token de página de larga duración (pages_read_engagement) de la página sodimusic.oficial.
# Facebook responde 400/403 a cualquier lectura anónima: sin token la fuente queda con lastError y no se toca la red.
# FACEBOOK_PAGE_TOKEN=""
# Recomendado: secreto del cron diario GET /api/cron/social-sync (Vercel lo envía como Authorization: Bearer).
# Sin él la ruta responde 503; la frescura la da el refresco perezoso del GET /api/social/feed.
# CRON_SECRET=""
